# The gateways' settings: copy to .env (git-ignored), fill in what you have.
# `docker compose run --rm omnishield gateways` says what is installed and configured.
# None is needed: a gateway without its settings runs on the example ones
# (bare, the console's --example) - the providers' own testing keys.

# Where the gateways' checkouts are, when this core sits in the workspace
# beside them (../.. from this directory); unset, they come from GitHub.
#OMNISHIELD_PLUGINS=../..

# Where omnisense/contracts' checkout is (../../../omnisense-contracts when it sits beside the
# family's folder); unset, it comes from GitHub.
#OMNISENSE_CONTRACTS=../../../omnisense-contracts

# omnishield/altcha: the key that signs the challenges.
ALTCHA_HMAC_KEY=

# omnishield/turnstile: a widget's keys. Cloudflare's testing keys:
# site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
# (passes), 2x0000000000000000000000000000000AA (fails), 3x... (spent).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# omnishield/recaptcha: checkbox, invisible, score or enterprise. Google's v2
# test keys: 6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI / 6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe.
RECAPTCHA_MODE=checkbox
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
# enterprise: the Google Cloud project and an API key of it.
RECAPTCHA_PROJECT_ID=
RECAPTCHA_API_KEY=

# omnishield/akismet: a key, the site's home page. AKISMET_TEST=1 sends is_test.
AKISMET_API_KEY=
AKISMET_SITE=
AKISMET_TEST=1

# omnishield/stopforumspam: looking up needs no key; reporting does.
STOPFORUMSPAM_THRESHOLD=50
STOPFORUMSPAM_API_KEY=
